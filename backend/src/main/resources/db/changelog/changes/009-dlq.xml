<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV136 — dlq_messages table
 WHAT:    Durable store for quarantined trade events. One row per message that
          DeadLetterPublishingRecoverer (ADV134) routed to trade-events-dlq;
          written by DlqConsumer, read/replayed/deleted by DlqAdminController.
 WHY:     ddl-auto=validate means the DlqMessage entity needs a matching table
          at startup. Without this changeset the app fails Hibernate schema
          validation and never boots.
 NOTE:    payload/reason use VARCHAR(1000000) (not CLOB/TEXT) for the same
          reason audit_log does — see 006-audit-and-recon.xml.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="009-create-dlq-messages" author="trainer">
        <createTable tableName="dlq_messages">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="event_id" type="VARCHAR(36)"><constraints nullable="false" unique="true"/></column>
            <column name="trade_ref" type="VARCHAR(30)"/>
            <column name="original_topic" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="partition_no" type="INT"><constraints nullable="false"/></column>
            <column name="record_offset" type="BIGINT"><constraints nullable="false"/></column>
            <column name="payload" type="VARCHAR(1000000)"/>
            <column name="reason" type="VARCHAR(1000000)"/>
            <column name="first_seen" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="dlq_messages" indexName="idx_dlq_messages_trade_ref">
            <column name="trade_ref"/>
        </createIndex>
        <rollback>
            <dropTable tableName="dlq_messages"/>
        </rollback>
    </changeSet>

</databaseChangeLog>