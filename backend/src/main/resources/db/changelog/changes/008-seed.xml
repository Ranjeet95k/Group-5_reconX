<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV017 / ADV014 — Seed data with preconditions

 WHAT:
        Loads development and test seed data.

 HOW:
        Seed changesets run only in dev/test contexts and check that rows
        do not already exist before inserting.

 WHY:
        Prevent duplicate seed data during repeated application startup.

 OBSERVE:
        First boot inserts data.
        Second boot skips seed changesets safely.
 ============================================================================
-->

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">


    <!-- Counterparties seed -->
    <changeSet 
            id="008-seed-counterparties"
            author="trainer"
            context="dev,test">

        <!-- TICKET-ADV014: Do not reload existing seed data -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM counterparties;
            </sqlCheck>
        </preConditions>


        <loadData 
            file="data/counterparties.csv"
            tableName="counterparties"
            separator=","
            relativeToChangelogFile="true">

            <column name="id" type="NUMERIC"/>
            <column name="name" type="STRING"/>
            <column name="lei_code" type="STRING"/>
            <column name="region" type="STRING"/>

        </loadData>


        <rollback>
            <sql>DELETE FROM counterparties;</sql>
        </rollback>

    </changeSet>




    <!-- Instruments seed -->
    <changeSet 
            id="008-seed-instruments"
            author="trainer"
            context="dev,test">

        <!-- TICKET-ADV014: Do not reload existing seed data -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM instruments;
            </sqlCheck>
        </preConditions>


        <loadData 
            file="data/instruments.csv"
            tableName="instruments"
            separator=","
            relativeToChangelogFile="true">

            <column name="id" type="NUMERIC"/>
            <column name="symbol" type="STRING"/>
            <column name="name" type="STRING"/>
            <column name="asset_class" type="STRING"/>
            <column name="currency" type="STRING"/>
            <column name="isin" type="STRING"/>

        </loadData>


        <rollback>
            <sql>DELETE FROM instruments;</sql>
        </rollback>

    </changeSet>




