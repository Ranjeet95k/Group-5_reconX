<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV007 / ADV014 — Monthly partitioning of trades on Postgres
 WHAT:    Convert trades into a range-partitioned parent on trade_date.
 HOW:     Postgres-only via raw SQL guarded by preConditions.
 WHY:     H2 does not support PostgreSQL partitioning syntax. MARK_RAN allows
          non-Postgres environments to continue migration safely.
 OBSERVE: Postgres applies partitioning changes; H2 skips this changeset.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">


    <!-- Demonstration only: partitioning is Postgres-specific -->
    <changeSet id="004-partition-current-month" author="trainer">

        <!-- TICKET-ADV014: Skip safely on databases without PostgreSQL support -->
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>


        <comment>
            Placeholder: students rebuild this in ADV007.
            Trainer copy ships a no-op so dev/uat boot cleanly.
        </comment>


        <sql>
            SELECT 1;
        </sql>


        <rollback>
            <sql>
                SELECT 1;
            </sql>
        </rollback>


    </changeSet>


</databaseChangeLog>