<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV008 / ADV014 — Materialised view mv_daily_recon_summary

 WHAT:
        Daily aggregate of matched/break counts + total notional.

 HOW:
        PostgreSQL-only materialized view creation guarded with Liquibase
        preconditions.

 WHY:
        Re-running migrations against an existing database must not fail.
        PostgreSQL-specific objects must be skipped safely on other databases.

 OBSERVE:
        PostgreSQL creates mv_daily_recon_summary.
        Existing databases mark this changeset as MARK_RAN.
 ============================================================================
-->

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">


    <changeSet id="005-mv-daily-recon-summary" author="trainer">

        <!--
            TICKET-ADV014:
            Run only on PostgreSQL and only when the materialized view
            does not already exist.
            MARK_RAN prevents duplicate execution on existing databases.
        -->
        <preConditions onFail="MARK_RAN">
            <and>
                <dbms type="postgresql"/>

                <not>
                    <tableExists tableName="mv_daily_recon_summary"/>
                </not>

            </and>
        </preConditions>


        <sql splitStatements="false"><![CDATA[

            CREATE MATERIALIZED VIEW mv_daily_recon_summary AS

            SELECT
                trade_date,
                COUNT(*) AS total_trades,

                COUNT(*) FILTER (
                    WHERE status = 'MATCHED'
                ) AS matched_trades,

                COUNT(*) FILTER (
                    WHERE status IN ('UNMATCHED','DISPUTED')
                ) AS break_trades,

                COALESCE(
                    SUM(quantity * price),
                    0
                ) AS total_notional

            FROM trades

            WHERE deleted_at IS NULL

            GROUP BY trade_date;


            CREATE UNIQUE INDEX uq_mv_daily_recon_summary_trade_date

            ON mv_daily_recon_summary (trade_date);


        ]]></sql>


        <rollback>

            <sql>
                DROP MATERIALIZED VIEW IF EXISTS mv_daily_recon_summary;
            </sql>

        </rollback>


    </changeSet>


</databaseChangeLog>